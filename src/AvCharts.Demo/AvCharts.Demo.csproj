<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>AvCharts.Demo</RootNamespace>
        <AssemblyName>AvChartsDemo</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsPackable>false</IsPackable>
        <!-- Same trade-off as the tests: CS1591 is the libraries' rule, and a gallery is pages, not API. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!--
            A library rather than an application: the gallery is pages and a shell, and a head puts them
            somewhere - `AvCharts.Demo.Desktop` in a window, `AvCharts.Demo.Browser` in a page.
        -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Avalonia.Themes.Simple" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="iPaas.Controls" />
        <PackageReference Include="Lucide.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AvCharts.Controls\AvCharts.Controls.csproj" />
    </ItemGroup>
</Project>
