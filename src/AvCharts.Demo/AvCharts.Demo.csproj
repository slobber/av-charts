<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>AvCharts.Demo</RootNamespace>
        <AssemblyName>AvChartsDemo</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsPackable>false</IsPackable>
        <!-- Same trade-off as the tests: CS1591 is the libraries' rule, and a gallery is pages, not API. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!--
            A library rather than an application: the gallery is pages and a shell, and a head puts them
            somewhere - `AvCharts.Demo.Desktop` in a window, `AvCharts.Demo.Browser` in a page.
        -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Avalonia.Themes.Simple" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="iPaas.Controls" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AvCharts.Controls\AvCharts.Controls.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The source of an example, kept as text beside whatever is compiled from it: the code half is compiled
            (so what its tab shows is code that builds rather than a copy of some code), the markup half is
            compiled into the assembly's XAML, and both are embedded under their own paths so that a tab can show
            them back - with the same code in a window and in a browser, which has no disk at all.
        -->
        <EmbeddedResource Include="Examples/**/*.cs;Examples/**/*.axaml" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The font the gallery's Chinese is drawn in, beside the licence it comes with. It is an application
            resource rather than an embedded one because the font manager reads it by its `avares://` address, and
            because a browser build has no fonts of its own to fall back on - see `DemoFonts`.
        -->
        <AvaloniaResource Include="Assets/AvChartsChinese-Regular.ttf" />
    </ItemGroup>
</Project>
