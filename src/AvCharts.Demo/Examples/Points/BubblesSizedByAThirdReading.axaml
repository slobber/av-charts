<avc:CartesianChart xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avc="https://github.com/slobber/av-charts"
                    xmlns:points="using:AvCharts.Demo.Examples.Points"
                    x:DataType="points:BubblesSizedByAThirdReading"
                    Height="180">
    <avc:CartesianChart.HorizontalAxis>
        <avc:LinearAxis Minimum="0" Maximum="10" Interval="5" />
    </avc:CartesianChart.HorizontalAxis>
    <avc:CartesianChart.VerticalAxis>
        <avc:LinearAxis Minimum="0" Maximum="10" Interval="5" />
    </avc:CartesianChart.VerticalAxis>
    <avc:BubbleSeries DisplayName="Sites"
                      ItemsSource="{x:Static points:BubblesSizedByAThirdReading.Sites}"
                      XPath="Across"
                      YPath="Up"
                      RadiusPath="Size" />
</avc:CartesianChart>
