<avc:CartesianChart xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avc="https://github.com/slobber/av-charts"
                    xmlns:statistics="using:AvCharts.Demo.Examples.Statistics"
                    x:DataType="statistics:BoxesFromFiveNumbers"
                    Height="180">
    <avc:CartesianChart.HorizontalAxis>
        <avc:CategoryAxis />
    </avc:CartesianChart.HorizontalAxis>
    <avc:CartesianChart.VerticalAxis>
        <avc:LinearAxis Minimum="0" Maximum="20" Interval="5" />
    </avc:CartesianChart.VerticalAxis>
    <avc:BoxSeries DisplayName="Samples"
                   ItemsSource="{x:Static statistics:BoxesFromFiveNumbers.Samples}"
                   XPath="Week"
                   MinimumPath="Minimum"
                   LowerQuartilePath="LowerQuartile"
                   MedianPath="Median"
                   UpperQuartilePath="UpperQuartile"
                   MaximumPath="Maximum" />
</avc:CartesianChart>
