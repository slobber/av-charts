<avc:CartesianChart xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avc="https://github.com/slobber/av-charts"
                    xmlns:candles="using:AvCharts.Demo.Examples.Candles"
                    x:DataType="candles:HighLowCloseBars"
                    Height="180">
    <avc:CartesianChart.HorizontalAxis>
        <avc:DateTimeAxis />
    </avc:CartesianChart.HorizontalAxis>
    <avc:CartesianChart.VerticalAxis>
        <avc:LinearAxis />
    </avc:CartesianChart.VerticalAxis>
    <avc:HighLowCloseSeries DisplayName="Northwind"
                            ItemsSource="{x:Static candles:HighLowCloseBars.Prices}"
                            XPath="Day"
                            OpenPath="Open"
                            HighPath="High"
                            LowPath="Low"
                            ClosePath="Close"
                            BandWidthRatio="0.35" />
</avc:CartesianChart>
