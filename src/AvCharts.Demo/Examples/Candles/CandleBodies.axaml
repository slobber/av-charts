<avc:CartesianChart xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avc="https://github.com/slobber/av-charts"
                    xmlns:candles="using:AvCharts.Demo.Examples.Candles"
                    x:DataType="candles:CandleBodies"
                    Height="180">
    <avc:CartesianChart.HorizontalAxis>
        <avc:DateTimeAxis />
    </avc:CartesianChart.HorizontalAxis>
    <avc:CartesianChart.VerticalAxis>
        <avc:LinearAxis />
    </avc:CartesianChart.VerticalAxis>
    <avc:CandlestickSeries DisplayName="Northwind"
                           ItemsSource="{x:Static candles:CandleBodies.Prices}"
                           XPath="Day"
                           OpenPath="Open"
                           HighPath="High"
                           LowPath="Low"
                           ClosePath="Close" />
</avc:CartesianChart>
