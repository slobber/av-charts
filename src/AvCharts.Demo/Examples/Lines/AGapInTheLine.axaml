<avc:CartesianChart xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avc="https://github.com/slobber/av-charts"
                    xmlns:lines="using:AvCharts.Demo.Examples.Lines"
                    x:DataType="lines:AGapInTheLine"
                    Height="180">
    <avc:CartesianChart.HorizontalAxis>
        <avc:CategoryAxis />
    </avc:CartesianChart.HorizontalAxis>
    <avc:CartesianChart.VerticalAxis>
        <avc:LinearAxis Minimum="0" Maximum="10" Interval="2" />
    </avc:CartesianChart.VerticalAxis>
    <avc:LineSeries DisplayName="Recorded"
                    ItemsSource="{x:Static lines:AGapInTheLine.OverTheWeek}"
                    XPath="Day"
                    YPath="Value"
                    NullValueMode="Gap"
                    Marker="{x:Static avc:Markers.Circle}"
                    MarkerSize="5" />
</avc:CartesianChart>
