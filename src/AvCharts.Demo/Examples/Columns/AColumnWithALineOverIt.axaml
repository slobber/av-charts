<avc:CartesianChart xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avc="https://github.com/slobber/av-charts"
                    xmlns:columns="using:AvCharts.Demo.Examples.Columns"
                    x:DataType="columns:AColumnWithALineOverIt"
                    Height="180">
    <avc:CartesianChart.HorizontalAxis>
        <avc:CategoryAxis />
    </avc:CartesianChart.HorizontalAxis>
    <avc:CartesianChart.VerticalAxis>
        <avc:LinearAxis Minimum="0" Maximum="10" Interval="2" />
    </avc:CartesianChart.VerticalAxis>
    <avc:ColumnSeries DisplayName="Traffic"
                      ItemsSource="{x:Static columns:AColumnWithALineOverIt.Traffic}"
                      XPath="Name"
                      YPath="Value"
                      BandWidthRatio="0.5" />
    <avc:LineSeries DisplayName="Success rate"
                    ItemsSource="{x:Static columns:AColumnWithALineOverIt.Rates}"
                    XPath="Name"
                    YPath="Value"
                    Marker="{x:Static avc:Markers.Circle}"
                    MarkerSize="5" />
</avc:CartesianChart>
