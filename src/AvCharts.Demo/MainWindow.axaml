<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvCharts.Demo.MainWindow"
        Width="960"
        Height="640"
        Title="AvCharts">
    <StackPanel Margin="24" Spacing="8">
        <TextBlock FontSize="20" Text="AvCharts" />
        <TextBlock Opacity="0.7" Text="The gallery fills in as the library does: light and dark side by side, one page per feature." />
    </StackPanel>
</Window>
