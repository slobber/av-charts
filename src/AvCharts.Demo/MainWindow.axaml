<Window
    x:Class="AvCharts.Demo.MainWindow"
    Title="AvCharts"
    Width="1180"
    Height="820"
    WindowStartupLocation="CenterScreen"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:AvCharts.Demo"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The window is a frame and nothing else: what the demo is - the catalogue, the pages, the styles - is the
        shell, so that the browser, which has no window to put anything in, is given the very same demo.
    -->
    <demo:Shell />
</Window>
