<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="using:AvCharts.Controls"
        x:Class="AvCharts.Demo.MainWindow"
        Width="820"
        Height="420"
        Title="AvCharts">
    <DockPanel Margin="16">
        <TextBlock
            DockPanel.Dock="Top"
            Margin="0,0,0,12"
            Opacity="0.7"
            Text="The gallery fills in as the library does. For now: one real line." />
        <av:CartesianChart x:Name="Chart" />
    </DockPanel>
</Window>
