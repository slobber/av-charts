<demo:DemoPage
    x:Class="AvCharts.Demo.Pages.DashboardPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avc="https://github.com/slobber/av-charts"
    xmlns:demo="using:AvCharts.Demo"
    xmlns:ipaas="using:iPaas.Controls"
    xmlns:vm="using:AvCharts.Demo.Dashboard"
    x:DataType="vm:DashboardViewModel"
    MaxContentWidth="1200"
    Title="Dashboard"
    Description="A production line at a glance: throughput, yield, OEE, the points that are running it, and the alarms that need somebody.">
    <StackPanel Spacing="8">
        <ipaas:Card>
            <Grid Margin="14,10" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Period" VerticalAlignment="Center" />
                    <ComboBox
                        Width="112"
                        ItemsSource="{Binding Ranges}"
                        SelectedItem="{Binding SelectedRange}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DashboardRangeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{Binding LiveBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LiveText}" VerticalAlignment="Center" />
                    <Button Command="{Binding TogglePauseCommand}" Content="{Binding PauseText}" />
                    <Button Command="{Binding RefreshCommand}" Content="Refresh" />
                </StackPanel>
            </Grid>
        </ipaas:Card>

        <UniformGrid Columns="4">
            <ipaas:Card Margin="0,0,8,0">
                <StackPanel Margin="10" Spacing="3">
                    <TextBlock Text="Throughput" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding ThroughputText}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding ThroughputDeltaText}" Foreground="#067647" FontSize="11" />
                        <TextBlock Text="vs last shift" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </ipaas:Card>
            <ipaas:Card Margin="0,0,8,0">
                <StackPanel Margin="10" Spacing="3">
                    <TextBlock Text="Yield" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding YieldText}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding YieldDeltaText}" Foreground="#067647" FontSize="11" />
                        <TextBlock Text="vs last shift" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </ipaas:Card>
            <ipaas:Card Margin="0,0,8,0">
                <StackPanel Margin="10" Spacing="3">
                    <TextBlock Text="OEE" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding OeeText}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding OeeDeltaText}" Foreground="#B42318" FontSize="11" />
                        <TextBlock Text="vs last shift" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </ipaas:Card>
            <ipaas:Card>
                <StackPanel Margin="10" Spacing="3">
                    <TextBlock Text="Active alarms" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding ActiveAlarmText}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding AlarmDeltaText}" Foreground="#B42318" FontSize="11" />
                        <TextBlock Text="vs last shift" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </ipaas:Card>
        </UniformGrid>

        <ipaas:Card>
            <StackPanel Margin="14" Spacing="6">
                <TextBlock Text="Throughput by bucket" FontSize="14" FontWeight="SemiBold" />
                <TextBlock
                    Text="Received and rejected readings, stacked"
                    FontSize="11"
                    Opacity="0.65" />
                <vm:LegendPanel Breakpoint="950">
                    <avc:Legend
                        x:Name="MainLegend"
                        Background="Transparent"
                        Placement="Top" />
                    <avc:CartesianChart
                        x:Name="ThroughputChart"
                        Height="170"
                        SeriesLayout="Stacked"
                        ShowCrosshair="True"
                        PanOnDrag="False"
                        ZoomOnWheel="False"
                        SelectionMode="Single">
                        <avc:CartesianChart.HorizontalAxis>
                            <avc:DateTimeAxis />
                        </avc:CartesianChart.HorizontalAxis>
                        <avc:CartesianChart.VerticalAxis>
                            <avc:LinearAxis Minimum="0" />
                        </avc:CartesianChart.VerticalAxis>
                    </avc:CartesianChart>
                </vm:LegendPanel>
            </StackPanel>
        </ipaas:Card>

        <!-- 1000 px of page is about 950 px of content: the page template keeps 24 px at each side. -->
        <vm:ResponsivePanel Breakpoint="950">
            <ipaas:Card>
                <StackPanel Margin="14" Spacing="6">
                    <TextBlock Text="OEE trend" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Availability × performance × quality" FontSize="11" Opacity="0.65" />
                    <avc:CartesianChart
                        x:Name="OeeChart"
                        Height="140"
                        ShowCrosshair="True"
                        PanOnDrag="False"
                        ZoomOnWheel="False">
                        <avc:CartesianChart.HorizontalAxis>
                            <avc:DateTimeAxis />
                        </avc:CartesianChart.HorizontalAxis>
                        <avc:CartesianChart.VerticalAxis>
                            <avc:LinearAxis Minimum="70" Maximum="100" Interval="5" />
                        </avc:CartesianChart.VerticalAxis>
                    </avc:CartesianChart>
                </StackPanel>
            </ipaas:Card>

            <ipaas:Card>
                <StackPanel Margin="14" Spacing="6">
                    <TextBlock Text="Active alarms by level" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Click a wedge to filter the event log"
                        FontSize="11"
                        Opacity="0.65" />
                    <avc:PieChart
                        x:Name="AlarmPie"
                        Height="140" />
                </StackPanel>
            </ipaas:Card>
        </vm:ResponsivePanel>

        <ipaas:Card>
            <StackPanel Margin="14" Spacing="8">
                <TextBlock Text="Live points" FontSize="14" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto,Auto,20,*,Auto,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Text="Line A"
                        FontSize="12"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Grid.Column="4"
                        Grid.ColumnSpan="3"
                        Text="Line B"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </Grid>
                <Grid ColumnDefinitions="*,80,58,20,*,80,58">
                    <TextBlock Grid.Column="0" Text="Point" FontSize="11" Opacity="0.6" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Value"
                        FontSize="11"
                        Opacity="0.6"
                        HorizontalAlignment="Right" />
                    <TextBlock
                        Grid.Column="2"
                        Text="Status"
                        FontSize="11"
                        Opacity="0.6"
                        HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Point" FontSize="11" Opacity="0.6" />
                    <TextBlock
                        Grid.Column="5"
                        Text="Value"
                        FontSize="11"
                        Opacity="0.6"
                        HorizontalAlignment="Right" />
                    <TextBlock
                        Grid.Column="6"
                        Text="Status"
                        FontSize="11"
                        Opacity="0.6"
                        HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,80,58,20,*,80,58">
                    <ItemsControl Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding LineAPoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PointReading">
                                <Grid Height="28" ColumnDefinitions="*,80,58">
                                    <TextBlock
                                        Text="{Binding DisplayName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding ValueText}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        FontFamily="monospace" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding StatusText}"
                                        Foreground="{Binding StatusBrush}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="4" Grid.ColumnSpan="3" ItemsSource="{Binding LineBPoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PointReading">
                                <Grid Height="28" ColumnDefinitions="*,80,58">
                                    <TextBlock
                                        Text="{Binding DisplayName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding ValueText}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        FontFamily="monospace" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding StatusText}"
                                        Foreground="{Binding StatusBrush}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </ipaas:Card>

        <ipaas:Card>
            <StackPanel Margin="14" Spacing="6">
                <TextBlock Text="Alarm events" FontSize="14" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="90,66,66,*,62,38" Margin="0,4,0,4">
                    <TextBlock Text="Time" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="Line" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="Severity" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="3" Text="Message" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="4" Text="State" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="5" Text="Ack" FontSize="11" Opacity="0.6" />
                </Grid>
                <ScrollViewer
                    MaxHeight="140"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VisibleAlarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlarmEvent">
                                <Grid
                                    Height="28"
                                    ColumnDefinitions="90,66,66,*,62,38"
                                    Opacity="{Binding StateOpacity}">
                                    <TextBlock
                                        Text="{Binding TimeText}"
                                        FontSize="10"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding LineText}"
                                        FontSize="10"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding SeverityText}"
                                        Foreground="{Binding SeverityBrush}"
                                        FontSize="10"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding MessageText}"
                                        FontSize="10"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{Binding StateText}"
                                        FontSize="10"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="5"
                                        Content="Ack"
                                        FontSize="10"
                                        Padding="6,2"
                                        IsVisible="{Binding IsActive}"
                                        Command="{Binding $parent[demo:DemoPage].((vm:DashboardViewModel)DataContext).AcknowledgeCommand}"
                                        CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </ipaas:Card>
    </StackPanel>
</demo:DemoPage>
