<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ipaas="using:iPaas.Controls"
             x:Class="AvCharts.Demo.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <!-- The house's own theme: the demo's chrome - a picker, a switch, a toggle - is made of it. -->
        <ipaas:Theme />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The default tokens and the chart's control theme, both variants. -->
                <ResourceInclude Source="avares://AvCharts.Controls/Themes/ChartTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
