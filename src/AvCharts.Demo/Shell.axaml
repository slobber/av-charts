<UserControl
    x:Class="AvCharts.Demo.Shell"
    xmlns="https://github.com/avaloniaui"
    xmlns:ipaas="using:iPaas.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <!--
            The demo application's own look: the page and the block an example is written in. The shell wears
            them rather than the window, so that a head which has no window - a browser - gets them too: a test
            that shows this control gets the same styles the application does.
        -->
        <StyleInclude Source="avares://AvChartsDemo/Styles/Demo.axaml" />
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*">
        <!--
            The catalogue, and under it the two settings that are about the demo rather than about a chart: which
            theme the whole application is wearing, and which language it is speaking. They are docked to the
            bottom of this column rather than sitting in it, so that a long catalogue scrolls above them and they
            stay where a reader looks for them.
        -->
        <DockPanel Grid.Column="0">
            <Border
                x:Name="Settings"
                DockPanel.Dock="Bottom"
                Padding="14,12"
                BorderBrush="#22000000"
                BorderThickness="0,1,0,0">
                <!--  The two settings are built in code, beside the pages they belong with: see `Shell.BuildSettings`.  -->
                <StackPanel x:Name="SettingsPanel" Spacing="12" />
            </Border>
        <!--
            The catalogue is the house's own `Sidebar`, which is the control its demos build a catalogue out of:
            a row of it knows how to hover, how to mark the page being shown, and how to fall back to its icon
            when the panel is collapsed. Building those rows out of plain buttons is what left the labels white
            on a white page - the theme's default button is the primary one, so dressing one as a row means
            overriding half of it by hand, and the half that was forgotten is the one that says what colour the
            text is.
        -->
        <ipaas:Sidebar x:Name="Catalogue">
            <ipaas:SidebarHeader>
                <!--  Its glyph is put on in code, the way every other row's is: see `Shell.Icon`.  -->
                <ipaas:SidebarMenuButton x:Name="Brand" Label="AvCharts" />
            </ipaas:SidebarHeader>
            <ipaas:SidebarContent>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Navigation" Spacing="8" />
                </ScrollViewer>
            </ipaas:SidebarContent>
            <ipaas:SidebarRail />
        </ipaas:Sidebar>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <!--  The header: the trigger for the catalogue, and what page this is.  -->
            <Border
                DockPanel.Dock="Top"
                Padding="20,14"
                BorderBrush="#22000000"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <ipaas:SidebarTrigger
                        x:Name="CatalogueTrigger"
                        Grid.Column="0"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="CurrentPage"
                            FontSize="15"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="CurrentAbout"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
