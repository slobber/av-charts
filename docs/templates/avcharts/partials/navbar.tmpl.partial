{{!The default template's navbar, with the site's controls on the right: the language of the documentation,
  light or dark, and the way back to the source. The search box is the default template's.}}

<nav id="autocollapse" class="navbar navbar-inverse ng-scope" role="navigation">
  <div class="container">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#navbar">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      {{>partials/logo}}
    </div>
    <div class="collapse navbar-collapse" id="navbar">
      <ul class="nav navbar-nav navbar-right avc-tools">
        <li>
          <span class="avc-langs" role="group" aria-label="Language / 语言">
            <a class="avc-lang" data-avc-lang="zh" href="{{_rel}}using/index.html" lang="zh-Hans" hreflang="zh-Hans">中文</a>
            <a class="avc-lang" data-avc-lang="en" href="{{_rel}}en/using/index.html" lang="en" hreflang="en">EN</a>
          </span>
        </li>
        <li>
          <button type="button" class="avc-theme" id="avc-theme" aria-label="Light or dark / 明或暗">
            <span class="avc-glyph avc-moon" aria-hidden="true">&#9789;</span>
            <span class="avc-glyph avc-sun" aria-hidden="true">&#9728;</span>
          </button>
        </li>
        <li>
          <a class="avc-github" href="https://github.com/slobber/av-charts" title="Source on GitHub / 源码">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            GitHub
          </a>
        </li>
      </ul>
      <form class="navbar-form navbar-right" role="search" id="search">
        <div class="form-group">
          <input type="text" class="form-control" id="search-query" placeholder="{{__global.search}}" autocomplete="off">
        </div>
      </form>
    </div>
  </div>
</nav>
