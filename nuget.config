<?xml version="1.0" encoding="utf-8"?>
<!--
    One feed: nuget.org, and everything this repository restores is on it - including `iPaas.Controls`, which
    the gallery wears and which used to come from the org's own feed. That feed is gone from this file on
    purpose: a build on GitHub's runners can reach nuget.org and cannot reach an address inside the office, and
    a source that cannot be reached fails the restore rather than being skipped.

    A host inside the org that wants the packages this repository publishes adds the CyberStone feed to *its
    own* nuget.config, where its address means something.
-->
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
