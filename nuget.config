<?xml version="1.0" encoding="utf-8"?>
<!--
    nuget.org carries the chart packages and their public dependencies, including Avalonia's ColorPicker
    control assembly. The gallery's design system, `iPaas.Controls`, is published on the organisation's
    CyberStone feed first; its package brings the matching house ColorPicker theme.
-->
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="CyberStone" value="https://baget.cyber-stone.com/v3/index.json" protocolVersion="3" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="CyberStone">
            <package pattern="iPaas.Controls" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
