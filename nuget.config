<?xml version="1.0" encoding="utf-8"?>
<!--
    Two feeds, each mapped to the packages it is for - the same shape the rest of the org uses. Without the
    mapping, central package management warns on every restore that it does not know which of the two to ask
    (NU1507) and then asks both.
-->
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="CyberStone" value="https://baget.cyber-stone.com/v3/index.json" protocolVersion="3" />
    </packageSources>
    <packageSourceMapping>
        <!-- Everything this repository publishes, and nothing else, comes from the private feed. -->
        <packageSource key="CyberStone">
            <package pattern="AvCharts*" />
            <package pattern="iPaas*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
